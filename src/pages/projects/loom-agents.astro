---
import Layout from '../../layouts/Layout.astro';
import { Content } from '../../data/loom.md';
import '../_root.css';
const title = 'Loom: coding agents I can manage from anywhere';
const summary = 'A desktop app, web app, mobile app and API for starting, steering and reviewing AI coding agents that run on my own machine, built solo as a TypeScript monorepo.';
---

<Layout title={`${title} | Nicholas Fitton`} description={summary}>
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="profile">
    <nav class="navigation" aria-label="Main navigation">
      <a class="wordmark" href="/" aria-label="Nicholas Fitton home">nf<span>.</span></a>
      <div><a href="/#projects">Projects & interests</a><a href="mailto:resume@nfitton.com">Contact ↗</a></div>
    </nav>
    <main id="main">
      <header class="detail-header">
        <a class="text-link" href="/#projects">← Back to projects</a>
        <p class="eyebrow">Personal project / Technical breakdown</p>
        <h1>{title}</h1>
        <p class="detail-copy" style="padding-bottom:0">{summary}</p>
        <div class="detail-facts"><span>Distributed systems & product engineering</span></div>
      </header>
      <article class="detail-copy loom-copy" aria-label="Loom technical breakdown">
        <p class="outcome"><span>Outcome</span>Loom runs agents from five harnesses through one worker on macOS. I can follow and review their work from the web, Android or another desktop. About 360 commits over two months (5 October to 27 November 2026) took it from an empty repository to signed macOS releases, an Android build and an on-demand release pipeline.</p>
        <Content />
      </article>
    </main>
    <footer class="footer"><a href="/#projects">← Back to projects & interests</a><a href="/nicholas-fitton-cv.pdf" download>Download CV ↓</a></footer>
  </div>
</Layout>

<style>
  .loom-copy :global(ul) { padding-left: 1.4em; margin: 18px 0; color: #bbb6c2; }
  .loom-copy :global(li + li) { margin-top: 12px; }
  .loom-copy :global(strong) { color: #e0d8e8; }
  .loom-copy :global(code) { font-size: 0.9em; overflow-wrap: anywhere; color: #e0d8e8; }
</style>
